# metoffice.cylc
[runtime]
    [[root]]
        platform = spice
        execution time limit = PT5M
        [[[directives]]]
            --wckey = CMEW
            --mem = 1G
            --ntasks = {{ MAX_PARALLEL_TASKS }}
        [[[environment]]]
            INSTITUTION_ID="MOHC"

    [[run_evaluation_tool<evaluation_tool=esmvaltool><recipe=radiation_budget>]]
        execution time limit = PT2M
        [[[directives]]]
            --mem = 3G

    [[standardise_model_data<dataset>]]
        execution time limit = PT10M
