# metoffice.cylc
[runtime]
    [[root]]
        platform = spice
        execution time limit = PT5M
        [[[directives]]]
            --wckey = CMEW
            --mem = 1G
            --ntasks = {{ MAX_PARALLEL_TASKS }}
        [[[environment]]]
            INSTITUTION_ID="MOHC"

{%- if ESMVALTOOL %}
    [[run_evaluation_tool<evaluation_tool=esmvaltool><recipe>]]
        execution time limit = PT1H
        [[[directives]]]
            --mem = 6G
            --ntasks = 1
        [[[environment]]]
            UCX_TLS = tcp,self

    [[run_cdds<dataset>]]
        execution time limit = PT1H
{%- endif %}
