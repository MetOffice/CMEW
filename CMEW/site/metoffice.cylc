# metoffice.cylc
[runtime]
    [[root]]
        [[[environment]]]
            INSTITUTION_ID="MOHC"
            DRS_OBS6 = default
            ROOTPATH_OBS6 = /data/users/esmval/ESMValTool/obs

    [[COMPUTE]]
        platform = spice
        [[[directives]]]
            --wckey = CMEW
            --ntasks = {{ MAX_PARALLEL_TASKS }}

{%- if annual_datasets %}
    [[standardise_model_data_annual<annual_dataset>]]
        [[[directives]]]
            --mem = 8G
{%- endif %}

{%- if not TEST and RECIPE == "ocean_quadmap" %}
    [[run_recipe<recipe=ocean_quadmap>]]
        execution time limit = PT10M
        [[[directives]]]
            --mem = 8G
{%- endif %}
