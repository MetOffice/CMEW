# metoffice.cylc
[runtime]
    [[root]]
        [[[environment]]]
            INSTITUTION_ID="MOHC"
            DRS_OBS6 = default
            ROOTPATH_OBS6 = /data/users/esmval/ESMValTool/obs

    [[COMPUTE]]
        platform = spice
        [[[directives]]]
            --wckey = CMEW
            --ntasks = {{ MAX_PARALLEL_TASKS }}

    [[run_recipe<recipe=ocean_quadmap>]]
        [[[directives]]]
            --time = 10
            --mem = 8G
