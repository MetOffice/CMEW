# autoassess.cylc

# This is fragile as it assumes the dataset sections are labelled
# 'reference' and 'experiment'.
{% set ref_dataset = datasets_metadata["model_reference"]["suite_id"] %}
{% set eval_dataset = datasets_metadata["model_experiment"]["suite_id"] %}
{% set ref_label = datasets_metadata["model_reference"]["label_for_plots"] %}
{% set eval_label = datasets_metadata["model_experiment"]["label_for_plots"] %}

[task parameters]
    aa_dataset = {{ [ref_dataset, eval_dataset] | join(", ") }}

[scheduling]
    [[graph]]
        R1 = """
            install_env_file
            => install_package<package=autoassess>
            => retrieve_data<autoassess_area><aa_dataset>
            => index_data<autoassess_area><aa_dataset>
            => run_area<autoassess_area>
            => nac_plot<autoassess_area>
            => html_page<autoassess_area>
            => html_page_overview
{%- if TEST %}
            html_page<autoassess_area> => check_expected_outputs<autoassess_area>
{%- endif %}
        """

    [[queues]]
        # Don't want to be hammering MASS!
        [[[mass_retrieval]]]
            limit = 4
            members = SITE_AA_RETRIEVAL


[runtime]
    [[root]]
        [[[environment]]]
            REF_SUITE_ID = {{ ref_dataset }}
            REF_SUITE_TITLE = {{ ref_label }}
            SUITE_ID = {{ eval_dataset }}
            SUITE_TITLE = {{ eval_label }}

    [[AUTOASSESS]]
        inherit = SITE_AUTOASSESS
        [[[environment]]]
            AUTOASSESS_OUTPUT_DIR = $OUTPUT_DIR/{{ eval_dataset }}_vs_{{ ref_dataset }}
            AUTOASSESS_DATA_DIR = $CYLC_WORKFLOW_SHARE_DIR/data/autoassess
            ASSESSMENT_TITLE = {{ OUTPUT_WEBPAGE_TITLE }}
            ESMVALTOOL_MODULE_NAME = {{ ESMVALTOOL_MODULE_NAME }}
            START_DATE = {{ (START_YEAR-1)|string + '/12/01' }}
            END_DATE = {{ (START_YEAR+NUMBER_OF_YEARS-1)|string + '/12/01' }}

    [[install_package<package=autoassess>]]
        inherit = AUTOASSESS, SITE_AA_INSTALL

    [[retrieve_data<autoassess_area><aa_dataset>]]
        inherit = AUTOASSESS, SITE_AA_RETRIEVAL
        [[[environment]]]
            ROSE_TASK_APP = extract_data
            ROSE_APP_OPT_CONF_KEYS = ($CYLC_TASK_PARAM_autoassess_area)
            SUITE_ID = $CYLC_TASK_PARAM_aa_dataset
            AREA = $CYLC_TASK_PARAM_autoassess_area

    [[index_data<autoassess_area><aa_dataset>]]
        inherit = AUTOASSESS, SITE_AA_DATA_INDEXING
        [[[environment]]]
            ROSE_TASK_APP = aa_index_data
            ROSE_APP_OPT_CONF_KEYS = ($CYLC_TASK_PARAM_autoassess_area)
            SUITE_ID = $CYLC_TASK_PARAM_aa_dataset
            AREA = $CYLC_TASK_PARAM_autoassess_area

    [[run_area<autoassess_area>]]
        inherit = AUTOASSESS, SITE_AA_RUN_AREA
        [[[environment]]]
            ROSE_TASK_APP = aa_run_area
            ROSE_APP_OPT_CONF_KEYS = ($CYLC_TASK_PARAM_autoassess_area)
            AREA = $CYLC_TASK_PARAM_autoassess_area

    [[nac_plot<autoassess_area>]]
        inherit = AUTOASSESS, SITE_AA_NAC_PLOT
        [[[environment]]]
            ROSE_TASK_APP = create_nac_plot
            ROSE_APP_OPT_CONF_KEYS = ($CYLC_TASK_PARAM_autoassess_area)
            AREA = $CYLC_TASK_PARAM_autoassess_area

    [[html_page<autoassess_area>]]
        inherit = AUTOASSESS, SITE_AA_HTML_PAGE
        [[[environment]]]
            ROSE_TASK_APP = aa_html_page
            ROSE_APP_OPT_CONF_KEYS = ($CYLC_TASK_PARAM_autoassess_area)
            AREA = $CYLC_TASK_PARAM_autoassess_area

    [[html_page_overview]]
        inherit = AUTOASSESS, SITE_AA_HTML_PAGE
        [[[environment]]]
            ROSE_TASK_APP = aa_html_page
            ROSE_APP_OPT_CONF_KEYS = template
            J2_TEMPLATE_FILE = top_level_template.jinja
            OUTPUT_FILE = ${AUTOASSESS_OUTPUT_DIR}/index.html
