# test.cylc

[task parameters]
    recipe = radiation_budget
    autoassess_area = monsoon

[runtime]
    [[check_expected_outputs<recipe>]]
        [[[environment]]]
            ROSE_TASK_APP = check_expected_outputs
            ROSE_APP_OPT_CONF_KEYS=${CYLC_TASK_PARAM_recipe}

    [[check_expected_outputs<autoassess_area>]]
        [[[environment]]]
            ROSE_TASK_APP = check_expected_outputs
            ROSE_APP_OPT_CONF_KEYS=${CYLC_TASK_PARAM_autoassess_area}
