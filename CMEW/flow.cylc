# flow.cylc
{% set SITE = SITE | default("") %}
{{ assert(
    SITE != "",
    "SITE must be set. Specify a site using '-O <site>', e.g. 'cylc vip -O metoffice'."
    ) }}
{{ assert(ESMVALTOOL_MODULE_NAME != "", "ESMVALTOOL_MODULE_NAME must be set to something other than an empty string") }}
{% set SKIP_CDDS = SKIP_CDDS | default(false) %}
{% set selected_recipe = "radiation_budget" if TEST else RECIPE %}

{% from "scrape_ini" import list_datasets, facet_per_dataset %}
{% set datasets = list_datasets("rose-suite.conf") %}

# Each model run's own "archive_stream" metadata (set in rose-suite.conf's
# [namelist:model_runs(...)] sections) is the single authoritative source
# for whether it uses the annual "ony" archive (via
# standardise_model_data_annual/standardise_ony_annual.py) or the default
# monthly "onm" archive (via cdds_convert). A future annual suite opts in
# purely by setting archive_stream="ony" in rose-suite.conf -- no code
# change is required here.
{% set archive_streams = facet_per_dataset("rose-suite.conf", "archive_stream", "onm") %}
{# list_datasets() returns a comma-separated string, not a list. #}
{% set datasets_list = datasets.split(", ") if datasets else [] %}
{% set annual_datasets = [] %}
{% set monthly_datasets = [] %}
{%- for dataset in datasets_list %}
{%- if archive_streams.get(dataset, "onm") == "ony" %}
{%- set _ = annual_datasets.append(dataset) %}
{%- else %}
{%- set _ = monthly_datasets.append(dataset) %}
{%- endif %}
{%- endfor %}

[scheduler]
    UTC mode = True

[task parameters]
{%- if monthly_datasets %}
    dataset = {{ monthly_datasets | join(", ") }}
{%- endif %}
    recipe = {{ selected_recipe }}
{%- if annual_datasets %}
    annual_dataset = {{ annual_datasets | join(", ") }}
{%- endif %}
{%- if not UNITTEST and AUTOASSESS %}
    autoassess_area = monsoon, africa
{%- endif %}

[scheduling]
    [[graph]]
        R1 = """
{%- if UNITTEST or TEST %}
            install_env_file => unittest
{%- endif %}
{%- if USE_ESMVALTOOL_BRANCH %}
            install_env_file => get_esmval_branch => configure_recipe & copy_datasets
{%- endif %}
{%- if not UNITTEST and not SKIP_CDDS %}
            install_env_file => configure_recipe & copy_datasets
            copy_datasets => configure_for<recipe>
    {%- if monthly_datasets %}
            configure_for<recipe> => configure_standardise<recipe,dataset>
                => standardise_model_data<dataset> => restructure_dirs
    {%- endif %}
            configure_recipe & restructure_dirs => run_recipe<recipe>
                => housekeeping
    {%- if annual_datasets %}
            # Opt-in annual "ony" route for the subset of model runs in
            # annual_dataset. Runs independently of the monthly route
            # above and writes into ROOT_DATA_DIR, so the existing
            # restructure_dirs task picks up its output unchanged.
            configure_for<recipe>
                => standardise_model_data_annual<annual_dataset>
                => restructure_dirs
    {%- endif %}

    {%- if TEST %}
            run_recipe<recipe> => compare<recipe>
        {%- if AUTOASSESS %}
            html_page<autoassess_area> => compare<autoassess_area>
        {%- endif %}
    {%- endif %}
{%- endif %}
{%- if SKIP_CDDS %}
    {%- if USE_ESMVALTOOL_BRANCH %}
            install_env_file => get_esmval_branch => configure_recipe & copy_datasets
    {%- endif %}
            install_env_file
            => configure_recipe & copy_datasets
            => configure_for<recipe>
            => symlink_standardised_data
            => run_recipe<recipe>
            => housekeeping
{%- endif %}
        """

[runtime]
    [[root]]
        script = rose task-run
        env-script = "eval $(rose task-env)"
        platform = localhost
        [[[environment]]]
            ESMVALTOOL_DIR=${CYLC_WORKFLOW_RUN_DIR}/lib/python/ESMValTool
            ESMVALTOOL_MODULE_NAME = {{ ESMVALTOOL_MODULE_NAME }}
            ESMVALTOOL_CONFIG_DIR = ${CYLC_WORKFLOW_SHARE_DIR}/etc/esmvaltool_config
            USER_CONFIG_PATH = ${ESMVALTOOL_CONFIG_DIR}/config-user.yml
            DEV_CONFIG_PATH = ${CYLC_WORKFLOW_SHARE_DIR}/etc/config-developer.yml
            OUTPUT_DIR = ${CYLC_WORKFLOW_SHARE_DIR}/cycle/${CYLC_TASK_CYCLE_POINT}
            PYTHONPATH_PREPEND = ${ESMVALTOOL_DIR}
            SHARE_DATA_CDDS = ${CYLC_WORKFLOW_SHARE_DIR}/data/cdds
            ROOT_PROC_DIR = ${SHARE_DATA_CDDS}/proc
            ROOT_DATA_DIR = ${SHARE_DATA_CDDS}/cdds_data
            ROOT_RESTRUCTURED_DIR = ${CYLC_WORKFLOW_SHARE_DIR}/work

    [[RECIPE]]
        [[[environment]]]
            RECIPE_NAME = "recipe_${CYLC_TASK_PARAM_recipe}.yml"
            RECIPE_PATH = "${CYLC_WORKFLOW_SHARE_DIR}/etc/${RECIPE_NAME}"
            VARIABLES_LIST_DIR = ${CYLC_WORKFLOW_SHARE_DIR}/variables_lists
            RECIPE_VARIABLES_PATH = ${VARIABLES_LIST_DIR}/${CYLC_TASK_PARAM_recipe}_variables.txt

    [[STANDARDISE]]
        [[[environment]]]
            CDDS_BIN_DIR = "~cdds/bin"
            CDDS_SOFTWARE_DIR = "~cdds/software"
            MODEL_PARAMS_DIR = ${CYLC_WORKFLOW_RUN_DIR}/app/configure_standardise/model_params
            RAW_DATA_DIR = {{ RAW_DATA_DIR | default("") }}
            RAW_DATA_DIR_MODE = {{ RAW_DATA_DIR_MODE }}
            # Workaround for bug in CDDS: ROOT_SOFTWARE_DIR: unbound variable.
            ROOT_SOFTWARE_DIR = ${CDDS_SOFTWARE_DIR}
            CDDS_VERSION = {{ CDDS_VERSION }}

    [[DATASET]]
        [[[environment]]]
            REQUEST_PATH = ${CYLC_WORKFLOW_SHARE_DIR}/etc/request_${CYLC_TASK_PARAM_dataset}.cfg
            VARIABLES_PATH = ${CYLC_WORKFLOW_SHARE_DIR}/etc/variables_${CYLC_TASK_PARAM_dataset}.txt
            RAW_DATA_DIR_SUITE = {{ RAW_DATA_DIR | default("") }}"/$CYLC_TASK_PARAM_dataset"

    [[ANNUAL_DATASET]]
        [[[environment]]]
            ANNUAL_END_YEAR = {{ START_YEAR + NUMBER_OF_YEARS - 1 }}
            # Model-specific ancillary/coordinate file paths are owned by
            # this JSON file (keyed by model_id), not hardcoded here, so
            # new annual model configurations don't require a flow.cylc
            # change.
            MODEL_ANCILLARIES_FP = ${CYLC_WORKFLOW_RUN_DIR}/app/standardise_model_data/model_ancillaries.json
            RECIPE_VARIABLES_PATH = ${CYLC_WORKFLOW_SHARE_DIR}/variables_lists/{{ selected_recipe }}_variables.txt

    [[MODEL_RUNS]]
        [[[environment]]]
            # Directory containing dataset lists as YAML files
            DATASETS_LIST_DIR = "${CYLC_WORKFLOW_SHARE_DIR}/dataset_lists"
            START_YEAR = {{ START_YEAR }}
            NUMBER_OF_YEARS = {{ NUMBER_OF_YEARS }}

    [[install_env_file]]
        [[[environment]]]
            SITE = {{ SITE }}

    [[configure_recipe]]
        [[[environment]]]
            CMEW_DATA_FOR_ESMVAL_DIR = ${ROOT_RESTRUCTURED_DIR}/GCModelDev
            DRS_CMIP6 = {{ DRS_CMIP6 }}
            DRS_OBS4MIPS = {{ DRS_OBS4MIPS }}
            MAX_PARALLEL_TASKS = {{ MAX_PARALLEL_TASKS }}
            MIP_TABLE_DIR = {{ MIP_TABLE_DIR }}
            ROOTPATH_CMIP6 = {{ ROOTPATH_CMIP6 }}
            ROOTPATH_OBS4MIPS = {{ ROOTPATH_OBS4MIPS }}

    [[configure_for<recipe>]]
        inherit = None, RECIPE, MODEL_RUNS
        [[[environment]]]
            ROSE_TASK_APP = configure_for

{%- if monthly_datasets %}
    [[configure_standardise<recipe,dataset>]]
        inherit = STANDARDISE, RECIPE, MODEL_RUNS, DATASET
        [[[environment]]]
            ROSE_TASK_APP = configure_standardise
            START_YEAR = {{ START_YEAR }}
            NUMBER_OF_YEARS = {{ NUMBER_OF_YEARS }}
            MIP_TABLE_DIR = {{ MIP_TABLE_DIR }}

    [[standardise_model_data<dataset>]]
        inherit = STANDARDISE, DATASET
        [[[environment]]]
            ROSE_TASK_APP = standardise_model_data
{%- endif %}

{%- if annual_datasets %}
    [[standardise_model_data_annual<annual_dataset>]]
        inherit = STANDARDISE, MODEL_RUNS, ANNUAL_DATASET
        [[[environment]]]
            ROSE_TASK_APP = standardise_model_data_annual
{%- endif %}

    [[restructure_dirs]]
        inherit = STANDARDISE
        [[[environment]]]
            SITE = {{ SITE }}

    [[run_recipe<recipe>]]
        inherit = None, COMPUTE, RECIPE
        [[[environment]]]
            ROSE_TASK_APP = run_recipe

    [[copy_datasets]]
        inherit = MODEL_RUNS
        [[[environment]]]
            ROSE_TASK_APP = copy_datasets

    [[get_esmval_branch]]
        [[[environment]]]
            ESMVALTOOL_BRANCH = {{ ESMVALTOOL_BRANCH | default("") }}

    [[symlink_standardised_data]]
        inherit = STANDARDISE
        [[[environment]]]
            STANDARDISED_DATA_DIR = {{ STANDARDISED_DATA_DIR | default("") }}

    [[housekeeping]]

{% include "site/" ~ SITE ~ ".cylc" %}
{%- if TEST or UNITTEST %}
    {% include "inc/unittest.cylc" %}
    {%- if TEST %}
        {% include "inc/test.cylc" %}
    {%- endif %}
{%- endif %}

{%- if not UNITTEST and AUTOASSESS %}
    {% include "site/" ~ SITE ~ "_autoassess.cylc" %}
    {% include "inc/autoassess.cylc" %}
{%- endif %}
