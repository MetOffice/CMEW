# flow.cylc
{% set SITE = SITE | default("") %}
{{ assert(
    SITE != "",
    "SITE must be set to something other than an empty string. Specify a site using '-O <site>', e.g. 'cylc vip -O metoffice'."
    ) }}
{{ assert(ESMVALTOOL_MODULE_NAME != "", "ESMVALTOOL_MODULE_NAME must be set to something other than an empty string") }}
{% set SKIP_CDDS = SKIP_CDDS | default(false) %}

{% from "inc/dataset.cylc" import datasets, datasets_metadata %}

{# What tool is running an area assessment, ESMValTool or AutoAssess? #}
{% set SOURCE_ASSESSMENT_AREAS = {
    "aerosols": "autoassess",
    "africa": "autoassess",
    "australia": "autoassess",
    "enso": "autoassess",
    "globaltrop": "autoassess",
    "hydrocycle": "autoassess",
    "land_surface": "autoassess",
    "mjo": "autoassess",
    "monsoon": "autoassess",
    "ocean_quadmap": "esmvaltool",
    "radiation_budget": "esmvaltool",
    "stratosphere": "autoassess",
    "valnote": "autoassess"} %}
{# Create a list of area assessments for each tool based on what has been selected #}
{% set split_areas = {"autoassess": [], "esmvaltool": []} %}
{% for area in ASSESSMENT_AREAS %}
    {% set tool = SOURCE_ASSESSMENT_AREAS[area] %}
    {% do split_areas[tool].append(area) %}
{% endfor %}
{# Create helper booleans to indicate if area assessments for particular tools have been selected #}
{% set AUTOASSESS = split_areas["autoassess"] | length > 0 %}
{% set ESMVALTOOL = split_areas["esmvaltool"] | length > 0 %}


[scheduler]
    UTC mode = True

[task parameters]
    package = autoassess, cmewpy
    evaluation_tool = autoassess, esmvaltool
    dataset = {{ datasets }}
{%- if ESMVALTOOL %}
    recipe = {{ split_areas["esmvaltool"] | join(",") }}
{%- endif %}
{%- if AUTOASSESS %}
    autoassess_area = {{ split_areas["autoassess"] | join(",") }}
{%- endif %}

[scheduling]
    [[graph]]
        R1 = """
            install_env_file
            => install_package<package=cmewpy>
{%- if ESMVALTOOL %}
{%- if USE_ESMVALTOOL_BRANCH %}
            install_package<package=cmewpy>
            => checkout_esmvaltool
            => create_esmvaltool_config & centralise_evaluation_metadata
{%- else %}
            install_package<package=cmewpy>
            => create_esmvaltool_config & centralise_evaluation_metadata
{%- endif %}
{%- if not SKIP_CDDS %}
            centralise_evaluation_metadata
            => update_esmvaltool_recipe<recipe>
            => create_cdds_config<recipe,dataset>
            => run_cdds<dataset>
            => reorganise_data_directories<evaluation_tool=esmvaltool>
            create_esmvaltool_config & reorganise_data_directories<evaluation_tool=esmvaltool>
            => run_evaluation_tool<evaluation_tool=esmvaltool><recipe>
            => housekeeping
{%- else %}
            centralise_evaluation_metadata
            => update_esmvaltool_recipe<recipe>
            => symlink_standardised_data
            => run_evaluation_tool<evaluation_tool=esmvaltool><recipe>
            => housekeeping
{%- endif %}
{%- if TEST %}
            run_evaluation_tool<evaluation_tool=esmvaltool><recipe> => check_expected_outputs<recipe>
{%- endif %}
{%- endif %}
        """

[runtime]
    [[root]]
        script = rose task-run
        env-script = "eval $(rose task-env)"
        [[[environment]]]
            ESMVALTOOL_DIR = ${CYLC_WORKFLOW_RUN_DIR}/lib/python/ESMValTool
            ESMVALTOOL_MODULE_NAME = {{ ESMVALTOOL_MODULE_NAME }}
            ESMVALTOOL_CONFIG_DIR = ${CYLC_WORKFLOW_SHARE_DIR}/etc/esmvaltool_config
            ESMVALTOOL_USER_CONFIG = config-user.yml
            ESMVALTOOL_SITE_DATA_KEY = {{ ESMVALTOOL_SITE_DATA_KEY }}
            ESMVALTOOL_SITE_CONFIG = data-hpc-${ESMVALTOOL_SITE_DATA_KEY}.yml
            USER_CONFIG_PATH = ${ESMVALTOOL_CONFIG_DIR}/${ESMVALTOOL_USER_CONFIG}
            SITE_CONFIG_PATH = ${ESMVALTOOL_CONFIG_DIR}/${ESMVALTOOL_SITE_CONFIG}
            OUTPUT_DIR = ${CYLC_WORKFLOW_SHARE_DIR}/cycle/${CYLC_TASK_CYCLE_POINT}
            PYTHONPATH_PREPEND = ${ESMVALTOOL_DIR}
            SHARE_DATA_CDDS = ${CYLC_WORKFLOW_SHARE_DIR}/data/cdds
            ROOT_PROC_DIR = ${SHARE_DATA_CDDS}/proc
            ROOT_DATA_DIR = ${SHARE_DATA_CDDS}/cdds_data
            ROOT_REORGANISED_DIR = ${CYLC_WORKFLOW_SHARE_DIR}/work
            START_YEAR = {{ START_YEAR }}
            NUMBER_OF_YEARS = {{ NUMBER_OF_YEARS }}

    [[RECIPE]]
        [[[environment]]]
            RECIPE_NAME = "recipe_${CYLC_TASK_PARAM_recipe}.yml"
            RECIPE_PATH = "${CYLC_WORKFLOW_SHARE_DIR}/etc/${RECIPE_NAME}"
            VARIABLES_LIST_DIR = ${CYLC_WORKFLOW_SHARE_DIR}/variables_lists
            RECIPE_VARIABLES_PATH = ${VARIABLES_LIST_DIR}/${CYLC_TASK_PARAM_recipe}_variables.txt

    [[STANDARDISE]]
        [[[environment]]]
            CDDS_BIN_DIR = "~cdds/bin"
            CDDS_SOFTWARE_DIR = "~cdds/software"
            RAW_DATA_DIR = {{ RAW_DATA_DIR | default("") }}
            RAW_DATA_DIR_MODE = {{ RAW_DATA_DIR_MODE }}
            # Workaround for bug in CDDS: ROOT_SOFTWARE_DIR: unbound variable.
            ROOT_SOFTWARE_DIR = ${CDDS_SOFTWARE_DIR}
            CDDS_VERSION = {{ CDDS_VERSION }}

    [[DATASET]]
        [[[environment]]]
            REQUEST_PATH = ${CYLC_WORKFLOW_SHARE_DIR}/etc/request_${CYLC_TASK_PARAM_dataset}.cfg
            VARIABLES_PATH = ${CYLC_WORKFLOW_SHARE_DIR}/etc/variables_${CYLC_TASK_PARAM_dataset}.txt
            RAW_DATA_DIR_SUITE = {{ RAW_DATA_DIR | default("") }}"/$CYLC_TASK_PARAM_dataset"

    [[MODEL_RUNS]]
        [[[environment]]]
            # Directory containing dataset lists as YAML files
            DATASETS_LIST_DIR = "${CYLC_WORKFLOW_SHARE_DIR}/dataset_lists"

    [[install_env_file]]
        [[[environment]]]
            SITE = {{ SITE }}

    [[install_package<package>]]
        [[[environment]]]
            ROSE_TASK_APP = install_package
            ROSE_APP_OPT_CONF_KEYS = ($CYLC_TASK_PARAM_package)

{%- if ESMVALTOOL %}
    [[create_esmvaltool_config]]
        [[[environment]]]
            CMEW_DATA_FOR_ESMVAL_DIR = ${ROOT_REORGANISED_DIR}/GCModelDev
            DRS_CMIP6 = {{ DRS_CMIP6 }}
            DRS_OBS4MIPS = {{ DRS_OBS4MIPS }}
            MAX_PARALLEL_TASKS = {{ MAX_PARALLEL_TASKS }}
            MIP_TABLE_DIR = {{ MIP_TABLE_DIR }}
            ROOTPATH_CMIP6 = {{ ROOTPATH_CMIP6 }}
            ROOTPATH_OBS4MIPS = {{ ROOTPATH_OBS4MIPS }}

    [[update_esmvaltool_recipe<recipe>]]
        inherit = RECIPE, MODEL_RUNS
        [[[environment]]]
            ROSE_TASK_APP = update_esmvaltool_recipe

    [[create_cdds_config<recipe,dataset>]]
        inherit = STANDARDISE, RECIPE, MODEL_RUNS, DATASET
        [[[environment]]]
            ROSE_TASK_APP = create_cdds_config
            START_YEAR = {{ START_YEAR }}
            NUMBER_OF_YEARS = {{ NUMBER_OF_YEARS }}
            MIP_TABLE_DIR = {{ MIP_TABLE_DIR }}

    [[run_cdds<dataset>]]
        inherit = STANDARDISE, DATASET
        [[[environment]]]
            ROSE_TASK_APP = run_cdds

    [[reorganise_data_directories<evaluation_tool=esmvaltool>]]
        inherit = STANDARDISE
        [[[environment]]]
            ROSE_TASK_APP = reorganise_data_directories
            ROSE_APP_OPT_CONF_KEYS = esmvaltool
            SITE = {{ SITE }}

    [[run_evaluation_tool<evaluation_tool=esmvaltool><recipe>]]
        inherit = RECIPE
        [[[environment]]]
            ROSE_TASK_APP = run_evaluation_tool
            ROSE_APP_OPT_CONF_KEYS = esmvaltool

    [[centralise_evaluation_metadata]]
        inherit = MODEL_RUNS
        [[[environment]]]
            ROSE_TASK_APP = centralise_evaluation_metadata

    [[checkout_esmvaltool]]
        [[[environment]]]
            ESMVALTOOL_BRANCH = {{ ESMVALTOOL_BRANCH | default("") }}

    [[symlink_standardised_data]]
        inherit = STANDARDISE
        [[[environment]]]
            STANDARDISED_DATA_DIR = {{ STANDARDISED_DATA_DIR | default("") }}
{%- endif %}

    [[housekeeping]]

{% include "site/" ~ SITE ~ ".cylc" %}
{%- if TEST  %}
    {% include "inc/test.cylc" %}
{%- endif %}

{%- if AUTOASSESS %}
    {% include "site/" ~ SITE ~ "_autoassess.cylc" %}
    {% include "inc/autoassess.cylc" %}
{%- endif %}
